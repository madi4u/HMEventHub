# H+M EventHub – Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================
# SUPABASE
# =============================================
# Found in: Supabase Dashboard > Project Settings > API

# Your project's public URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your project's anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this in the browser!
# Used for server-side admin operations only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================
# APP
# =============================================

# The public URL of your app (no trailing slash)
# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================
# OPTIONAL: Email / SMTP
# =============================================
# Supabase handles transactional email by default.
# Configure custom SMTP in: Supabase Dashboard > Authentication > SMTP Settings

# =============================================
# OPTIONAL: Storage
# =============================================
# Storage buckets are auto-configured via migration 003.
# No additional env vars needed for Supabase Storage.

# =============================================
# OPTIONAL: Analytics / Monitoring
# =============================================
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
